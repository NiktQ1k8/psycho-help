# Шаблон .env для стенда. На сервере копируется рядом с docker-compose.stand.yml
# и заполняется реальными значениями. В git не коммитится.

# PUBLIC_BASE_URL - публичный адрес стенда, каким его видит браузер.
# Сервер стоит за пробросом портов: снаружи 95.31.169.106, внутри 192.168.10.10.
# Здесь нужен именно ВНЕШНИЙ адрес - на него уходят редиректы.

# --- prod ---
STAND=prod
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_BASE_URL=https://95.31.169.106

# --- dev ---
# STAND=dev
# HTTP_PORT=8080
# HTTPS_PORT=8443
# PUBLIC_BASE_URL=https://95.31.169.106:8443

# Каталог с самоподписанным сертификатом (stand.crt + stand.key),
# общий для обоих стендов. Создаётся скриптом scripts/gen-cert.sh
CERT_DIR=/opt/psycho/certs
