{
  "name": "psycho-help",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "stylelint": "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore",
    "stylelint:fix": "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b",
    "db:backup": "sh scripts/local-backup.sh backup",
    "db:restore": "sh scripts/local-backup.sh restore"
  },
  "dependencies": {
    "@ant-design/compatible": "5.1.4",
    "@ant-design/icons": "6.1.0",
    "@tanstack/react-query": "^5.90.5",
    "antd": "5.27.4",
    "antd-mask-input": "^2.0.7",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "rc-picker": "^4.11.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.13.0",
    "swiper": "^12.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/css-modules": "^1.0.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "24.6.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/swiper": "^5.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.8",
    "sass": "^1.93.2",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.9",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^5.0.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
