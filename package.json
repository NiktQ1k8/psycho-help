{
  "name": "psycho-help",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "stylelint": "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore",
    "stylelint:fix": "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b",
    "db:backup": "sh scripts/local-backup.sh backup",
    "db:restore": "sh scripts/local-backup.sh restore"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@rc-component/picker": "^1.16.0",
    "@tanstack/react-query": "^5.105.1",
    "antd": "^6.6.8",
    "antd-img-crop": "^4.30.0",
    "axios": "^1.21.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "input-format": "^0.3.14",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "swiper": "^14.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/css-modules": "^1.0.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "allowScripts": {
    "@parcel/watcher": true
  }
}
